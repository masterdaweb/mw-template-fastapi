# On Master da Web the bindings give these: the database (libpq layout:
# PG*) and the bucket (prefix MW_STORAGE_). Export them to run the API locally.
PGHOST=localhost
PGPORT=5432
PGDATABASE=app
PGUSER=app
PGPASSWORD=
PGSSLMODE=prefer
MW_STORAGE_ENDPOINT=
MW_STORAGE_REGION=auto
MW_STORAGE_BUCKET=
MW_STORAGE_ACCESS_KEY_ID=
MW_STORAGE_SECRET_ACCESS_KEY=
MW_STORAGE_FORCE_PATH_STYLE=true
